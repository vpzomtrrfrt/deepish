<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
	xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
	xmlns="http://usefulinc.com/ns/doap#"
	xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
>
	<Project>
		<name>Deepish</name>
		<created>2025-11-08</created>

		<shortdesc xml:lang="en">A familiar experience within the XMPP ecosystem</shortdesc>

		<homepage rdf:resource="https://deepish.vpzom.click/" />
		<bug-database rdf:resource="https://gitlab.com/vpzomtrrfrt/deepish/-/issues" />

		<license rdf:resource="https://gitlab.com/vpzomtrrfrt/deepish/-/raw/master/LICENSE" />

		<programming-language>TypeScript</programming-language>
		<category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-client"/>
		<os>Browser</os>

		<repository>
			<GitRepository>
				<location rdf:resource="https://gitlab.com/vpzomtrrfrt/deepish.git" />
				<browse rdf:resource="https://gitlab.com/vpzomtrrfrt/deepish" />
			</GitRepository>
		</repository>

		<implements rdf:resource="https://xmpp.org/rfcs/rfc6120.html" />
		<implements rdf:resource="https://xmpp.org/rfcs/rfc6121.html" />
		<implements rdf:resource="https://xmpp.org/rfcs/rfc6122.html" />

		<implements>
			<xmpp:SupportedXep>
				<xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0030.html" />
				<xmpp:status>complete</xmpp:status>
			</xmpp:SupportedXep>
		</implements>

		<implements>
			<xmpp:SupportedXep>
				<xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0045.html" />
				<xmpp:version>1.35.3</xmpp:version>
				<xmpp:status>partial</xmpp:status>
				<xmpp:note xml:lang="en">
					Can join and create rooms. Missing support for registered nicknames.
				</xmpp:note>
			</xmpp:SupportedXep>
		</implements>

		<implements>
			<xmpp:SupportedXep>
